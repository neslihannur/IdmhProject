@{
    Layout = "_Layout";
}

<div id="carouselExampleIndicators" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
    <ol class="carousel-indicators">
        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="0" class="active"></li>
        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="1"></li>
        <li data-bs-target="#carouselExampleIndicators" data-bs-slide-to="2"></li>
    </ol>
    <div class="carousel-inner">
        <div class="carousel-item active">
            <img src="~/Img-Slider/slider1.jpg" class="d-block w-100" alt="Slider 1" style="height: 100vh; object-fit: cover; width: 100%;">
            <h6 class="soft-text" style="position: absolute; top: 20%; left: 20%; transform: translateY(-50%); animation-delay: 0.5s;">İbrahim Durmaz Mimarlık Hizmetleri</h6>
            <h1 class="soft-text" style="position: absolute; top: 30%; left: 20%; transform: translateY(-50%); animation-delay: 0.8s;">Estetik Dokunuş</h1>
            <button class="contact-button" onclick="location.href='@Url.Action("Iletisim", "Home")'" style="animation-delay: 1.2s;">İletişime Geç</button>
        </div>
        <div class="carousel-item">
            <img src="~/Img-Slider/slider2.jpg" class="d-block w-100" alt="Slider 2" style="height: 100vh; object-fit: cover; width: 100%;">
            <h6 class="soft-text" style="position: absolute; top: 20%; left: 20%; transform: translateY(-50%); animation-delay: 0.5s;">İbrahim Durmaz Mimarlık Hizmetleri</h6>
            <h1 class="soft-text" style="position: absolute; top: 30%; left: 20%; transform: translateY(-50%); animation-delay: 0.8s;">Özgün Tasarımlar</h1>
            <button class="contact-button" onclick="location.href='@Url.Action("Iletisim", "Home")'" style="animation-delay: 1.2s;">İletişime Geç</button>
        </div>
        <div class="carousel-item">
            <img src="~/Img-Slider/slider3.jpg" class="d-block w-100" alt="Slider 3" style="height: 100vh; object-fit: cover; width: 100%;">
            <h6 class="soft-text" style="position: absolute; top: 20%; left: 20%; transform: translateY(-50%); animation-delay: 0.5s;">İbrahim Durmaz Mimarlık Hizmetleri</h6>
            <h1 class="soft-text" style="position: absolute; top: 30%; left: 20%; transform: translateY(-50%); animation-delay: 0.8s;">Sürdürülebilir Mimari</h1>
            <button class="contact-button" onclick="location.href='@Url.Action("Iletisim", "Home")'" style="animation-delay: 1.2s;">İletişime Geç</button>
        </div>
    </div>
    <a class="carousel-control-prev" href="#carouselExampleIndicators" role="button" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </a>
    <a class="carousel-control-next" href="#carouselExampleIndicators" role="button" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </a>
</div>

<style>
    .soft-text {
        color: rgba(255, 255, 255, 0.8); /* Beyaz ve yarı opak renk */
        transition: opacity 0.5s ease-in-out; /* Geçiş efekti */
        text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5); /* Hafif gölge */
    }

    .carousel-item h6, .carousel-item h1, .contact-button {
        opacity: 0; /* Başlangıçta görünmez */
        transition: opacity 0.5s ease-in-out; /* Geçiş efekti */
        position: absolute;
        left: 20%; /* Sola hizala */
        transform: translateY(-50%);
    }

    .carousel-item.active h6,
    .carousel-item.active h1,
    .carousel-item.active .contact-button {
        opacity: 1; /* Aktif resimde görünür hale getir */
    }

    .contact-button {
        top: 40%; /* Yüksekliği ayarlayın */
        background-color: rgba(255, 255, 255, 0.2); /* Hafif beyaz arka plan */
        color: #fff; /* Beyaz yazı */
        border: 1px solid #fff; /* Beyaz kenarlık */
        padding: 10px 20px;
        font-size: 14px;
        cursor: pointer;
        border-radius: 5px;
        transition: background-color 0.3s, color 0.3s;
    }

        .contact-button:hover {
            background-color: rgba(255, 255, 255, 0.4); /* Hover durumunda daha açık */
            color: #000; /* Hover durumunda siyah yazı */
        }
</style>
