@{
    var title = ViewData["Title"] as string;
    var description = ViewData["Description"] as string ?? "IDMH İbrahim Durmaz Mimarlık Hizmetleri: mimari tasarım, iç mimarlık ve mimari revizyon. İstanbul.";
    var dark = ViewData["Dark"] is true;
    var path = Context.Request.Path.Value ?? "/";
    string Active(string p) => path.StartsWith(p) ? "is-active" : "";
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(title is null ? "IDMH — Mimarlık & İç Mimarlık" : $"{title} — IDMH")</title>
    <meta name="description" content="@description">
    <meta name="robots" content="noindex, nofollow">
    <meta name="theme-color" content="#0B0B0B">
    <meta property="og:title" content="@(title ?? "IDMH — Mimarlık & İç Mimarlık")">
    <meta property="og:description" content="@description">
    <meta property="og:image" content="@($"{Context.Request.Scheme}://{Context.Request.Host}/img/white-house.jpg")">
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%230B0B0B'/%3E%3Cpath d='M18 46V18h6v28zM30 46V18h6v28zM42 46V30h6v16z' fill='%23F2F1ED'/%3E%3C/svg%3E">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter+Tight:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
    <noscript><style>.preloader,.curtain,.cursor{display:none}</style></noscript>
</head>
<body class="@(dark ? "is-dark" : "")">
    <div class="preloader" data-preloader aria-hidden="true">
        <div class="preloader-inner">
            <span class="preloader-mark">IDMH</span>
            <span class="preloader-count" data-count>0</span>
        </div>
    </div>
    <div class="curtain" data-curtain aria-hidden="true"></div>
    <div class="cursor" data-cursor aria-hidden="true"><span data-cursor-label></span></div>

    <header class="header" data-header>
        <a href="/" class="brand" aria-label="IDMH ana sayfa">
            <span class="brand-mark">IDMH</span>
            <span class="brand-sub">Mimarlık<br>& İç Mimarlık</span>
        </a>
        <nav class="nav" aria-label="Ana menü">
            <a href="/projeler" class="@Active("/projeler")"><span>Projeler</span></a>
            <a href="/hizmetler" class="@Active("/hizmetler")"><span>Hizmetler</span></a>
            <a href="/ofis" class="@Active("/ofis")"><span>Ofis</span></a>
            <a href="/yazilar" class="@Active("/yazilar")"><span>Yazılar</span></a>
            <a href="/iletisim" class="@Active("/iletisim")"><span>İletişim</span></a>
        </nav>
        <a href="/iletisim?hizmet=Mimari%20Tasar%C4%B1m#form" class="header-cta">Teklif al</a>
        <button class="menu-btn" type="button" aria-label="Menü" aria-expanded="false" data-menu-btn><span></span><span></span></button>
    </header>

    <div class="menu" data-menu hidden>
        <nav>
            <a href="/projeler"><small>01</small>Projeler</a>
            <a href="/hizmetler"><small>02</small>Hizmetler</a>
            <a href="/ofis"><small>03</small>Ofis</a>
            <a href="/yazilar"><small>04</small>Yazılar</a>
            <a href="/iletisim"><small>05</small>İletişim</a>
        </nav>
        <div class="menu-foot">
            <a href="tel:+905404364024">+90 540 436 40 24</a>
            <a href="mailto:info@idmh.com.tr">info@idmh.com.tr</a>
        </div>
    </div>

    <main id="main">
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="wrap footer-top">
            <div class="footer-lead">
                <p class="eyebrow">Yeni bir proje</p>
                <a href="/iletisim" class="footer-big" data-hover="Konuşalım">Bir mekân<br>hayal edin.</a>
            </div>
            <div class="footer-cols">
                <div>
                    <p class="eyebrow">Ofis</p>
                    <p>Abdurrahmangazi Mah.<br>Fatih Bulvarı No:71 D:1<br>Sultanbeyli / İstanbul</p>
                </div>
                <div>
                    <p class="eyebrow">İletişim</p>
                    <p><a href="tel:+905404364024" class="u">+90 540 436 40 24</a><br><a href="mailto:info@idmh.com.tr" class="u">info@idmh.com.tr</a></p>
                </div>
                <div>
                    <p class="eyebrow">Sayfalar</p>
                    <p><a href="/projeler" class="u">Projeler</a><br><a href="/hizmetler" class="u">Hizmetler</a><br><a href="/ofis" class="u">Ofis</a><br><a href="/yazilar" class="u">Yazılar</a></p>
                </div>
            </div>
        </div>
        <div class="footer-word" aria-hidden="true"><span data-footer-word>IDMH</span></div>
        <div class="wrap footer-bottom">
            <span>© @DateTime.UtcNow.Year IDMH İbrahim Durmaz Mimarlık Hizmetleri</span>
            <span>Tasarım konsepti, <a href="https://portfolio.neslihannur.com.tr" target="_blank" rel="noopener" class="u">Neslihan Nur Han</a> · <a href="/gorsel-kaynaklari" class="u">Görsel kaynakları</a> · <a href="/kvkk" class="u">KVKK</a></span>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/lenis@1.1.13/dist/lenis.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
