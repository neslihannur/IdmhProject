@{
    var path = Context.Request.Path.Value ?? "";
    string A(string p, bool exact = false) => (exact ? path == p : path.StartsWith(p)) ? "is-active" : "";
    var flash = TempData["Flash"] as string;
}
<!doctype html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex">
    <title>@ViewData["Title"] — IDMH Yönetim</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true">
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="adm">
        <aside class="side">
            <a href="/yonetim" class="logo">IDMH <small>Yönetim</small></a>
            <nav>
                <a href="/yonetim" class="@A("/yonetim", true)">Pano</a>
                <a href="/yonetim/projeler" class="@A("/yonetim/projeler")">Projeler</a>
                <a href="/yonetim/yazilar" class="@A("/yonetim/yazilar")">Yazılar</a>
                <a href="/yonetim/talepler" class="@A("/yonetim/talepler")">Talepler</a>
                <a href="/yonetim/sifre" class="@A("/yonetim/sifre")">Şifre</a>
            </nav>
            <div class="side-foot">
                <a href="/" target="_blank">Siteyi aç ↗</a>
                <form method="post" action="/yonetim/cikis" asp-antiforgery="true"><button>Çıkış</button></form>
            </div>
        </aside>
        <main class="main">
            <header class="top"><h1>@ViewData["Title"]</h1>@RenderSection("Actions", required: false)</header>
            @if (flash is not null) { <div class="flash">@flash</div> }
            @RenderBody()
        </main>
    </div>
}
else
{
    @RenderBody()
}
</body>
</html>
