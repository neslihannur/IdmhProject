@model JournalPost
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Yeni yazı" : Model.Title;
}
@section Actions {
    @if (!isNew)
    {
        <a href="/yazilar/@Model.Slug" target="_blank" class="btn ghost">Sitede gör ↗</a>
        <form method="post" action="/yonetim/yazilar/@Model.Id/sil" asp-antiforgery="true" onsubmit="return confirm('Yazı silinsin mi?')"><button class="btn ghost">Sil</button></form>
    }
}
<a href="/yonetim/yazilar" class="back">← Yazılar</a>
@if (ViewData["Error"] is string e) { <div class="alert">@e</div> }
<form method="post" action="@(isNew ? "/yonetim/yazilar/yeni" : $"/yonetim/yazilar/{Model.Id}")" asp-antiforgery="true" enctype="multipart/form-data" class="two-col">
    <section class="card form">
        <label>Başlık <input name="Title" value="@Model.Title" required></label>
        <label>Adres <input name="Slug" value="@Model.Slug"></label>
        <label>Özet <textarea name="Excerpt" rows="2">@Model.Excerpt</textarea></label>
        <label>Metin (boş satır = paragraf, "## " ara başlık, "> " alıntı) <textarea name="Body" rows="18">@Model.Body</textarea></label>
    </section>
    <section class="card form">
        <label class="check"><input type="checkbox" name="IsPublished" value="true" checked="@Model.IsPublished"> Yayında</label>
        <input type="hidden" name="IsPublished" value="false">
        <label>Etiket <input name="Tag" value="@Model.Tag" placeholder="Tasarım, Süreç…"></label>
        <label>Yayın tarihi <input name="PublishedOn" type="date" value="@Model.PublishedOn.ToString("yyyy-MM-dd")"></label>
        <div>
            <p class="label">Kapak görseli</p>
            @if (!string.IsNullOrEmpty(Model.Cover)) { <img src="@Text.Small(Model.Cover)" alt="" class="preview"> }
            <input type="hidden" name="Cover" value="@Model.Cover">
            <input type="file" name="coverFile" accept="image/jpeg,image/png,image/webp">
        </div>
        <button class="btn block">Kaydet</button>
    </section>
</form>
