@model List<Project>
@{
    ViewData["Title"] = "Projeler";
    var alan = ViewData["Alan"] as string;
    var counts = (Dictionary<string, int>)ViewData["Counts"]!;
}
<section class="page-head wrap">
    <p class="eyebrow">( Projeler · @counts.Values.Sum() )</p>
    <h1 class="display-xl" data-split>Seçili <em>çalışmalar</em></h1>
    <nav class="filters" aria-label="Disiplin">
        <a href="/projeler" class="@(alan is null ? "is-active" : "")">Tümü <sup>@counts.Values.Sum()</sup></a>
        @foreach (var d in new[] { "Mimarlık", "İç Mimarlık", "Mimari Revizyon" })
        {
            <a href="/projeler?alan=@Uri.EscapeDataString(d)" class="@(alan == d ? "is-active" : "")">@d <sup>@counts.GetValueOrDefault(d)</sup></a>
        }
    </nav>
</section>

<section class="wrap project-grid">
    @for (var i = 0; i < Model.Count; i++)
    {
        var p = Model[i];
        var size = (i % 5) switch { 0 => "pg-wide", 3 => "pg-tall", _ => "" };
        <a href="/projeler/@p.Slug" class="pg-item @size" data-cursor-text="İncele" data-fade-up>
            <div class="ph"><img src="@(size == "" ? Text.Small(p.Cover) : p.Cover)" alt="@p.Title" loading="lazy"></div>
            <div class="pg-meta">
                <h2>@p.Title</h2>
                <span>@p.Discipline</span>
                <span>@p.Location</span>
                <span>@p.Year</span>
            </div>
        </a>
    }
    @if (Model.Count == 0)
    {
        <p class="muted">Bu alanda henüz yayınlanmış proje yok.</p>
    }
</section>

<section class="wrap list-view">
    <p class="eyebrow">( Liste )</p>
    <ul class="project-list" data-hover-list>
        @foreach (var p in Model)
        {
            <li>
                <a href="/projeler/@p.Slug" class="pl-row" data-img="@Text.Small(p.Cover)">
                    <span class="pl-title">@p.Title</span>
                    <span>@p.Typology</span>
                    <span>@p.Location</span>
                    <span>@p.Status</span>
                    <span>@p.Year</span>
                </a>
            </li>
        }
    </ul>
    <div class="hover-img" data-hover-img aria-hidden="true"><img alt=""></div>
    <p class="disclaimer">Bu site bir tasarım konseptidir; proje görselleri temsilîdir. Fotoğraf kaynakları için <a href="/gorsel-kaynaklari" class="u">görsel kaynakları</a> sayfasına bakın.</p>
</section>
